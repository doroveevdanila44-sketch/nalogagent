# Скопируйте в .env.local и заполните. Секреты не коммитить.

# Строка подключения Postgres. Neon: используйте pooled-строку (хост с -pooler).
# Локально: npm run db:dev, затем postgres://postgres:postgres@127.0.0.1:54329/pva
DATABASE_URL=
# Корневой сертификат для Yandex Managed PostgreSQL (PEM, переводы строк как \n). Для Neon не нужен.
DATABASE_SSL_CA=

# Серверный секрет для хэшей PIN, 32+ случайных байта: openssl rand -base64 48
PIN_PEPPER=
# Секрет подписи (CSRF, ключи журнала входа): openssl rand -base64 48
SESSION_SECRET=

# Блокировка на PIN
PIN_IDLE_MINUTES=5
PIN_BACKGROUND_SECONDS=60

# stub | gigachat | yandexgpt
LLM_PROVIDER=stub
# Только финал
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=

# Часовой пояс для приветствий и расчёта дат
APP_TZ=Asia/Kamchatka
